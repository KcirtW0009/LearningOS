# --------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.sublime-*
.vscode/settings.json
.project
.classpath
.c9/
.vs/
*.swp
*.swo
*~
.history/
.trae/

# --------------------------------------------
