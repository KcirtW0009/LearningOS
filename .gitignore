# ============================================
# LearningOS .gitignore
# ============================================

# --------------------------------------------
# Presentation Files (PPT, slides, generator)
# --------------------------------------------
/presentation/

# --------------------------------------------
# Python Virtual Environments
# --------------------------------------------
venv/
env/
.venv/
.env/
env.bak/
venv.bak/

# --------------------------------------------
# Python Bytecode & Compiled Files
# --------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pyd
*.so
*.egg-info/
*.egg
dist/
*.egg-info
runtime/*.egg-info/

# --------------------------------------------
# Python Tooling
# --------------------------------------------
.ruff_cache/
.mypy_cache/
.pytest_cache/
.pyre/
.hypothesis/

# --------------------------------------------
# Node.js / JavaScript
# --------------------------------------------
node_modules/
frontend/node_modules/
electron/node_modules/
runtime/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------------------------
# Build Artifacts
# --------------------------------------------
release/
dist/
build/
out/
.next/
.cache/
.parcel-cache/
*.tsbuildinfo
.DS_Store.store
electron-builder/

# Frontend specific
frontend/.next/
frontend/out/
frontend/.build/
frontend/.cache/
frontend/tsconfig.tsbuildinfo

# Runtime specific
runtime/dist/
runtime/build/
runtime/backend.spec
runtime/los.egg-info/

# --------------------------------------------
# Environment Variables & Secrets
# --------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.test
.env.production
.env.staging
*.env
secrets.json
secrets.yaml
credentials.json

# --------------------------------------------
